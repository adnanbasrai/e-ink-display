// OPTIONAL. secrets.h is a dev convenience, not required to flash a board.
//
// A freshly-flashed board with no secrets.h (or a blank one) just boots
// straight into its own WiFi setup hotspot ("SubwayBoard-XXXX") -- join it
// from a phone and pick a network there. That's the intended path for boards
// given to friends: flash once, no WiFi credentials baked in, they self-serve.
//
// Filling this in is only a shortcut for YOUR dev board, so it auto-connects
// to your network without going through the portal every time you reflash.
// secrets.h is gitignored either way.
#pragma once

#define WIFI_SSID     "your-network-name"
#define WIFI_PASSWORD "your-password"
